# Copy to .env and edit. Compose reads .env automatically; `docker compose config`
# fails immediately if PI_AGENT_DIR is unset, because the responder mounts it.
#
# Careful with precedence: a variable that is ALREADY exported in your shell wins
# over .env, silently. On Windows + WSL this bites because Windows environment
# variables leak into WSL, so an old PI_MODEL from a different project overrides
# the file you just edited and the container runs a model you did not choose.
# `docker compose config | grep PI_MODEL` shows the value that will actually be
# used; the responder also warns at startup when .env and its own environment
# disagree (issue #8).

# Required. The directory holding pi's models.json / settings.json, mounted
# read-only into the responder and copied to a writable path by entrypoint.sh
# (pi rewrites its own lock and session files, so a read-only mount makes pi
# report a missing API key that is actually present).
PI_AGENT_DIR=C:/Users/you/.pi/agent

# The model the investigating agent runs on. Both must be set or pi falls back to
# whatever ambient default its config happens to hold, and the incident verdict
# then came from a model nobody selected.
PI_PROVIDER=ollama
PI_MODEL=Qwen3.6-35B-A3B-Instruct

# Host ports. Every one is published on 127.0.0.1 only. Change these when
# something else already holds the default -- in this fork GRAFANA_PORT is 3001
# because an unrelated container owns 3000.
ORDER_TRACKER_PORT=8000
GRAFANA_PORT=3001
GRAFANA_PASSWORD=admin
PROMETHEUS_PORT=9090
LOKI_PORT=3100
TEMPO_PORT=3200
RESPONDER_PORT=8001
COLLECTOR_PROM_PORT=8889

# Optional overrides (defaults shown in compose.yaml):
# ORDER_TRACKER_TAG=local
# ORDER_TRACKER_SUBNET=10.215.24.0/24
# AGENT_COOLDOWN_MS=900000
